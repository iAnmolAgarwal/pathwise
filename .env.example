DATABASE_URL=
ANTHROPIC_API_KEY=
# Sign in with Google (README "Sign-in").
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Deployed host only: the production origin. Keep the line commented out locally — to
# Auth.js an empty value counts as set, and it switches host trust off.
# AUTH_URL=https://your-host.example.app
# Judge mode (README "Judge mode"); both optional, tokens per UTC day.
# JUDGE_USER_DAILY_TOKENS=150000
# JUDGE_GLOBAL_DAILY_TOKENS=3000000
# Only for `npm start` on localhost; Vercel provides it in production.
# AUTH_TRUST_HOST=true
