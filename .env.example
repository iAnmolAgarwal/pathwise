DATABASE_URL=
ANTHROPIC_API_KEY=
# Sign in with Google (README "Sign-in"). AUTH_URL is only needed on the deployed host.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=
# Judge mode (README "Judge mode"); both optional, tokens per UTC day.
JUDGE_USER_DAILY_TOKENS=
JUDGE_GLOBAL_DAILY_TOKENS=
# Only for `npm start` on localhost; Vercel provides it in production.
AUTH_TRUST_HOST=
